{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cell-one.sacred.v0",
  "title": "Cell One sacred exclusions file",
  "description": "Dual-layer sacred ids. Hardcoded LOCKED_SACRED always applies. File overlays are additive. Omitting a locked id does not remove it.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "cell-one.sacred.v0" },
    "locked": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "overlays": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": { "type": "string" }
      }
    }
  }
}
