{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "estate.v0.schema.json",
  "title": "Agent Estate desired-state v0",
  "description": "Documentary JSON Schema for Cell One. The fail-closed source of truth is the Rust validator in crates/estate-schema. Extra properties are allowed so the file can grow without a city-scale freeze.",
  "type": "object",
  "required": ["version", "name", "agents", "lanes"],
  "properties": {
    "version": { "type": "integer", "const": 0 },
    "apiVersion": {
      "type": "string",
      "description": "Optional Cell One config version. Absent is legacy v0. Known: cell-one.estate.v0, v0. Unknown fail-closed."
    },
    "kind": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "schema": { "type": "string" },
    "default_effect": { "type": "string", "enum": ["deny", "allow"] },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/definitions/agent" }
    },
    "lanes": {
      "type": "array",
      "items": { "$ref": "#/definitions/lane" }
    },
    "intentions": {
      "type": "array",
      "items": { "$ref": "#/definitions/intention" }
    },
    "model_bindings": {
      "type": "array",
      "items": { "$ref": "#/definitions/model_binding" }
    },
    "sacred_exclusions": {
      "type": "array",
      "items": { "$ref": "#/definitions/sacred_exclusion" }
    },
    "enrich_packs": { "$ref": "#/definitions/enrich_packs" },
    "placements": {
      "type": "array",
      "items": { "$ref": "#/definitions/placement" }
    },
    "packs": {
      "type": "array",
      "description": "Agent packs: named group membership with optional orchestrator. Distinct from enrich_packs. estate pack export-plugin writes an Agent Plugin stub (plugin.json + mcp.json + skills/) from one pack. Exported MCP runs estate pack mcp-serve → estate complete. live_sync stays false. Not live Cursor/Grok Bot sync.",
      "items": { "$ref": "#/definitions/agent_pack" }
    },
    "pack_packages": {
      "type": "array",
      "description": "Pack packages: named skills on a pack (Grok Bot skill analog). Run via estate package run → complete --pack; receipt stamps package_id. Security stays existing intentions.",
      "items": { "$ref": "#/definitions/pack_package" }
    },
    "routines": {
      "type": "array",
      "description": "Standing routines: declare + run a pack package (automation analog). Optional schedule is local tick state (estate routine tick). export-plugin copies the schedule as a commented cron/trigger note only. Not live Grok Bot sync. No DAG daemon.",
      "items": { "$ref": "#/definitions/routine" }
    }
  },
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "agent_pack": {
      "type": "object",
      "required": ["id", "members"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/slug" }
        },
        "orchestrator": { "$ref": "#/definitions/slug" },
        "chain": {
          "type": "array",
          "description": "Ordered multi-hop policy (alias steps). Each hop is agent → model binding.",
          "items": { "$ref": "#/definitions/chain_hop" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/chain_hop" }
        }
      }
    },
    "chain_hop": {
      "type": "object",
      "required": ["agent", "binding"],
      "properties": {
        "agent": { "$ref": "#/definitions/slug" },
        "binding": { "$ref": "#/definitions/slug" }
      }
    },
    "pack_package": {
      "type": "object",
      "required": ["id", "pack"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "pack": { "$ref": "#/definitions/slug" },
        "prompt": { "type": "string" },
        "binding": { "$ref": "#/definitions/slug" },
        "note": { "type": "string" },
        "chain": {
          "type": "array",
          "description": "Ordered multi-hop (alias steps). estate package run --chain.",
          "items": { "$ref": "#/definitions/chain_hop" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/chain_hop" }
        }
      }
    },
    "routine": {
      "type": "object",
      "required": ["id", "package"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "package": { "$ref": "#/definitions/slug" },
        "note": { "type": "string" },
        "schedule": {
          "type": "string",
          "description": "5-field cron or @daily / @hourly / @every Nh / @every Nm. Minimum interval 5m. Local tick only."
        },
        "enabled": { "type": "boolean" }
      }
    },
    "agent": {
      "type": "object",
      "required": ["id", "display_name", "lane", "desktop"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "display_name": { "type": "string", "minLength": 1 },
        "lane": { "$ref": "#/definitions/slug" },
        "desktop": { "type": "string", "minLength": 1 },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/definitions/slug" },
              "description": { "type": "string" }
            }
          }
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": { "$ref": "#/definitions/slug" },
              "path": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/definitions/slug" },
              "description": { "type": "string" }
            }
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/definitions/slug" },
              "description": { "type": "string" }
            }
          }
        },
        "calls": {
          "type": "array",
          "description": "Estate agents this agent may call. Empty is not a grant. Not a tool.",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/definitions/slug" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "lane": {
      "type": "object",
      "required": ["id", "root_path", "owner_agent_id"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "root_path": { "type": "string", "minLength": 1 },
        "owner_agent_id": { "$ref": "#/definitions/slug" }
      }
    },
    "intention": {
      "type": "object",
      "required": ["subject_agent", "object", "kind", "effect"],
      "properties": {
        "subject_agent": { "$ref": "#/definitions/slug" },
        "object": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["memory_read", "tool", "mcp", "mount", "model", "agent"],
          "description": "agent is who-may-call-whom. Aliases agent_call and agent-call load as agent. Object is an estate agent id, bare or agent:."
        },
        "effect": { "type": "string", "enum": ["allow", "deny"] },
        "note": { "type": "string" }
      }
    },
    "model_binding": {
      "type": "object",
      "required": ["id", "class", "driver", "wired"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "class": { "type": "string", "enum": ["frontier", "local"] },
        "driver": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "wired": { "type": "boolean" }
      }
    },
    "enrich_packs": {
      "type": "object",
      "description": "Jason curates first specialist enrich packs. Policy is manual. Not auto-promote.",
      "properties": {
        "curator": { "type": "string" },
        "policy": { "type": "string", "enum": ["manual"] },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/definitions/slug" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "description": "Where agents run. box = this Cell One. cloud-agent is declared, not spawned by floor.",
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "kind": { "type": "string", "enum": ["box", "cloud-agent"] },
        "host_class": {
          "type": "string",
          "enum": ["consumer-nvidia", "apple-silicon", "rented-nvidia", "any"]
        },
        "agents": {
          "type": "array",
          "items": { "$ref": "#/definitions/slug" }
        },
        "wired": { "type": "boolean" },
        "params": { "type": "object" },
        "note": { "type": "string" },
        "ttl_secs": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional lease lifetime. Absent = no expiry. expire --forget then apply restamps."
        }
      }
    },
    "sacred_exclusion": {
      "type": "object",
      "required": ["id", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
