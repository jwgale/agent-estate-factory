{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "estate.v0.schema.json",
  "title": "Agent Estate desired-state v0",
  "description": "Documentary JSON Schema for Cell One. The fail-closed source of truth is the Rust validator in crates/estate-schema. Extra properties are allowed so the file can grow without a city-scale freeze.",
  "type": "object",
  "required": ["version", "name", "agents", "lanes"],
  "properties": {
    "version": { "type": "integer", "const": 0 },
    "kind": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "schema": { "type": "string" },
    "default_effect": { "type": "string", "enum": ["deny", "allow"] },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/definitions/agent" }
    },
    "lanes": {
      "type": "array",
      "items": { "$ref": "#/definitions/lane" }
    },
    "intentions": {
      "type": "array",
      "items": { "$ref": "#/definitions/intention" }
    },
    "model_bindings": {
      "type": "array",
      "items": { "$ref": "#/definitions/model_binding" }
    },
    "sacred_exclusions": {
      "type": "array",
      "items": { "$ref": "#/definitions/sacred_exclusion" }
    }
  },
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "agent": {
      "type": "object",
      "required": ["id", "display_name", "lane", "desktop"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "display_name": { "type": "string", "minLength": 1 },
        "lane": { "$ref": "#/definitions/slug" },
        "desktop": { "type": "string", "minLength": 1 },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/definitions/slug" },
              "description": { "type": "string" }
            }
          }
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": { "$ref": "#/definitions/slug" },
              "path": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/definitions/slug" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "lane": {
      "type": "object",
      "required": ["id", "root_path", "owner_agent_id"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "root_path": { "type": "string", "minLength": 1 },
        "owner_agent_id": { "$ref": "#/definitions/slug" }
      }
    },
    "intention": {
      "type": "object",
      "required": ["subject_agent", "object", "kind", "effect"],
      "properties": {
        "subject_agent": { "$ref": "#/definitions/slug" },
        "object": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["memory_read", "tool", "mcp", "mount"]
        },
        "effect": { "type": "string", "enum": ["allow", "deny"] },
        "note": { "type": "string" }
      }
    },
    "model_binding": {
      "type": "object",
      "required": ["id", "class", "driver", "wired"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "class": { "type": "string", "enum": ["frontier", "local"] },
        "driver": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "wired": { "type": "boolean" }
      }
    },
    "sacred_exclusion": {
      "type": "object",
      "required": ["id", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
